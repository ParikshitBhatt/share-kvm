<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2563EB" android:endColor="#4F46E5" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp" android:drawable="@mipmap/ic_launcher" />
</layer-list>
